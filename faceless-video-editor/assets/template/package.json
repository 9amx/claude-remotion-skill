{
  "name": "faceless-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automated faceless video pipeline: script -> voiceover -> B-roll -> captions -> music -> render",
  "scripts": {
    "auto": "node scripts/auto.mjs",
    "lint": "node scripts/lint-script.mjs",
    "voice": "node scripts/auto.mjs --only=voice",
    "transcribe": "node scripts/transcribe.mjs",
    "broll": "node scripts/fetch-broll.mjs",
    "timeline": "node scripts/build-timeline.mjs",
    "audio": "node scripts/gen-audio.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "check": "node scripts/check.mjs",
    "thumbnail": "node scripts/thumbnail.mjs",
    "youtube": "node scripts/youtube.mjs",
    "adobe": "node scripts/adobe-stock.mjs",
    "editor": "node scripts/editor.mjs --open",
    "remote": "node scripts/remote-agent.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "d3-geo": "^3.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@remotion/install-whisper-cpp": "^4.0.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.6.0"
  }
}
